        <mxCell id="32" value="• Formulir kertas&lt;br&gt;• Spreadsheet rekap&lt;br&gt;• WhatsApp / telepon&lt;br&gt;• Arsip fisik&lt;br&gt;• Belum ada database terpusat" style="text;align=left;verticalAlign=top;fontSize=10;fontColor=#374151;whiteSpace=wrap;html=1;" vertex="1" parent="1">
